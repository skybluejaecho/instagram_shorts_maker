{
  "version": 1,
  "title": "스택은 왜 나중에 넣은 값이 먼저 나올까?",
  "durationSeconds": 30,
  "narration": [
    { "id": "hook", "text": "접시처럼 쌓인 데이터, 어떤 것부터 꺼낼까요?" },
    { "id": "idea", "text": "스택은 한쪽 끝에서만 값을 넣고 꺼내는 자료 구조입니다." },
    { "id": "show", "text": "에이를 넣고, 그 위에 비를 넣었다고 해보죠." },
    { "id": "compare", "text": "비가 먼저 나옵니다. 나중에 들어갔기 때문이죠." },
    { "id": "remaining", "text": "에이가 그다음 나오죠. 이 순서가 후입선출입니다." },
    { "id": "finish", "text": "되돌리기 기능도 최근 작업부터 취소할 때 스택을 활용할 수 있습니다." }
  ],
  "scenes": [
    { "id": "question", "type": "question", "from": "hook", "headline": "쌓인 데이터,\n무엇부터 꺼낼까?" },
    { "id": "definition", "type": "explanation", "from": "idea", "headline": "한쪽 끝에서\n넣고 꺼내요", "body": "새 값은 맨 위로\n꺼낼 때도 맨 위부터" },
    { "id": "insert", "type": "cards", "from": "show", "headline": "A를 넣고\n그 위에 B", "body": "아래에서 위로 쌓입니다.", "layout": "stack", "cards": [{ "id": "a", "label": "A" }, { "id": "b", "label": "B" }] },
    { "id": "remove", "type": "cards", "from": "compare", "headline": "나중에 온 B가\n먼저 나옵니다", "body": "꺼내는 순서  B → A", "cards": [{ "id": "b", "label": "B" }, { "id": "a", "label": "A" }], "carry": ["a", "b"], "actions": [{ "type": "highlight", "target": "b", "at": "compare" }] },
