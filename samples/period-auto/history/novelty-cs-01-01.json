  "narration": [
    {
      "id": "size_q",
      "text": "스택에 값을 넣고 꺼내면 크기는 어떻게 달라질까요?"
    },
    {
      "id": "size_rule",
      "text": "크기는 들어 있는 값의 개수입니다. 빈 스택의 크기는 0입니다."
    },
    {
      "id": "size_push_a",
      "text": "에이를 push하면 크기는 0에서 1이 됩니다."
    },
    {
      "id": "size_a_state",
      "text": "에이가 든 상태에서 현재 크기는 1입니다."
    },
    {
      "id": "size_push_b",
      "text": "비를 push하면 크기는 1에서 2가 됩니다."
    },
    {
      "id": "size_pop_b",
      "text": "비를 pop하면 크기는 2에서 1로 줄어듭니다."
    },
    {
      "id": "size_end",
      "text": "정리하면 push는 1을 더하고, 값이 있을 때 pop은 1을 뺍니다."
    }
  ],
